# Dakini CRM — Frontend Environment Variables
# Gateway API base URL (defaults to http://localhost:8080/v1)
VITE_GATEWAY_URL=http://localhost:8080/v1

# Organization / Tenant ID
VITE_TENANT_ID=dakini-enterprise

# Layer 9 Analytics Base URL (routed through Gateway)
VITE_ANALYTICS_BASE_URL=http://localhost:8080/v1/analytics

