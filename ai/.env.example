# Dakini CRM — Layer 5 AI & Transcript Service Environment Variables
DATABASE_URL=postgresql+asyncpg://postgres.your-ref:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Set the same random secret in Layer 3 and Layer 5. Do not expose this to the browser.
AI_INTERNAL_API_KEY=your_shared_internal_api_key_here

# OpenAI-compatible Chat Completions API. This key stays on the server only.
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=40
AI_DEFAULT_TIMEZONE=Asia/Kolkata
ENVIRONMENT=development
