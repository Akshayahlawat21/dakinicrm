# ==============================================================================
# Dakini CRM — Layer 3 Application & Data Layer Environment Variables
# ==============================================================================

# Server Runtime
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=dakini-layer3-app
SERVICE_VERSION=1.0.0

# Database Connectivity (Supabase PostgreSQL / Local PostgreSQL)
# Format: postgresql+psycopg://postgres:<PASSWORD>@<HOST>:5432/postgres
# Or for local testing / development: sqlite+aiosqlite:///./crm.db
DATABASE_URL=postgresql+psycopg://postgres.your-supabase-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Project Config (Optional for Storage & Auth verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_ENABLE_RLS=true

# Security & Gateway Secret Validation
# Must match Layer 2 Gateway JWT configuration
JWT_SECRET=dakini-crm-dev-super-secret-key-change-in-production-123456789
JWT_ALGORITHM=HS256
REQUIRE_TRUSTED_GATEWAY_HEADERS=false
