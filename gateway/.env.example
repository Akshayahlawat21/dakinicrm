# ==============================================================================
# Dakini CRM — Layer 2 Edge / API Gateway Environment Variables
# ==============================================================================

# Server Runtime
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8080
SERVICE_NAME=dakini-layer2-gateway
SERVICE_VERSION=1.0.0

# E1: Edge Shield (CDN / WAF / Cloudflare)
# Set to true in staging/production where Cloudflare/AWS CloudFront protects the origin
EDGE_SHIELD_ENABLED=false
EDGE_SHIELD_HEADER_NAME=X-Edge-Secret
EDGE_SHIELD_SECRET=change-me-to-a-secure-random-edge-token-in-production

# E2 & E3: Upstream Layer 3 Application API (FastAPI / Django)
# Configured by the Python backend team
UPSTREAM_API_URL=http://localhost:8000
UPSTREAM_TIMEOUT_SECONDS=15.0
# Set to true for frontend development before Layer 3 service is started
MOCK_UPSTREAM_IF_DOWN=true

# E6: Request Limits & Restrictive CORS
MAX_HEADER_SIZE_BYTES=16384
MAX_BODY_SIZE_BYTES=1048576
MAX_UPLOAD_SIZE_BYTES=10485760
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# E4: Authentication (JWT & Identity Provider / JWKS)
# For shared secret (development / standard HMAC)
JWT_SECRET=dakini-crm-dev-super-secret-key-change-in-production-123456789
JWT_ALGORITHM=HS256
# For OIDC IdP (Auth0 / Keycloak / Cognito JWKS public key verification)
# JWKS_URL=https://auth.dakini.ai/.well-known/jwks.json
# JWT_ISSUER=https://auth.dakini.ai/
# JWT_AUDIENCE=dakini-crm-api

# E5: Rate Limiting & Quotas
RATE_LIMIT_ENABLED=true
# Optional distributed Redis store (leave empty to use in-memory sliding window store)
# REDIS_URL=redis://localhost:6379/0

# Rate limits (requests per window)
RATE_LIMIT_LOGIN=10
RATE_LIMIT_READS=300
RATE_LIMIT_WRITES=60
RATE_LIMIT_BULK=5
RATE_LIMIT_AI=20
RATE_LIMIT_WEBHOOKS=100
RATE_LIMIT_TENANT=3000
